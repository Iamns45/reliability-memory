{
  "name": "reliability-memory",
  "version": "1.3.0",
  "description": "Evidence-specific customer resolution with verified experience and bounded autonomy",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.aws.config.ts",
    "build": "vite build --config vite.aws.config.ts",
    "build:aws-ui": "vite build --config vite.aws.config.ts",
    "start": "vite preview --config vite.aws.config.ts",
    "test": "npm run test:web && npm run test:core",
    "test:web": "npm run build && node --test tests/*.test.mjs",
    "test:core": "python3 -m unittest discover -s services/api/tests -v",
    "lint": "eslint .",
    "lint:docs": "python3 scripts/check_docs.py",
    "lint:infra": "cfn-lint infra/aws/template.yaml && bash -n scripts/deploy_aws.sh",
    "lint:python": "mypy services/api/app scripts --no-incremental",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write . && black services/api scripts",
    "format:check": "prettier --check . && black --check services/api scripts",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run format:check && npm run lint:docs && npm run lint && npm run lint:infra && npm run lint:python && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "type": "module",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
