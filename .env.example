# Local development defaults to deterministic provider adapters.
USE_BEDROCK=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
CORS_ORIGINS=http://localhost:3000

# Use either a direct CockroachDB URL or an AWS Secrets Manager ARN.
DATABASE_URL=
DATABASE_SECRET_ARN=

# Managed MCP is optional locally and required by the AWS deployment.
COCKROACH_MCP_API_KEY=
COCKROACH_MCP_SECRET_ARN=
COCKROACH_MCP_CLUSTER_ID=
COCKROACH_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_DATABASE=reliability_memory
COCKROACH_MCP_REQUIRED=false
COCKROACH_MCP_TIMEOUT_SECONDS=12
